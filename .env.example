# ==============================================================================
# JusticeMitra Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure with your service credentials.
# NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# --- MongoDB Atlas Vector Search ---
# Connection URI for your MongoDB Atlas cluster (M0 or higher).
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=justicemitra_db
MONGODB_COLLECTION=legal_chunks
MONGODB_VECTOR_INDEX=vector_index
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_TIMEOUT_MS=5000

# --- Google Gemma Inference Gateway ---
# Endpoint URL and API key serving Gemma instruction-tuned model.
# Defaults to Groq's high-speed inference endpoint serving Gemma 2 9B-IT.
# Can also point to Hugging Face Dedicated Endpoints, vLLM, or Ollama.
GEMMA_API_BASE=https://api.groq.com/openai/v1
GEMMA_API_KEY=
GEMMA_MODEL_NAME=gemma2-9b-it
GEMMA_TEMPERATURE=0.1
GEMMA_MAX_TOKENS=1024
GEMMA_TIMEOUT_SECONDS=30.0

# --- Sentry Observability & AI Agent Tracing ---
# Sentry DSN for performance tracing, error tracking, and AI Agent Spans.
# If omitted or empty, Sentry tracing will run in standby mode.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- Embedding & Retrieval Parameters ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=4
RETRIEVAL_CANDIDATES_MULTIPLIER=10
SIMILARITY_THRESHOLD=0.55

# --- Web Service Port ---
# Bound dynamically by Render via $PORT; defaults to 8501 locally.
PORT=8501
